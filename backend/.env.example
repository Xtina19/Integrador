# =============================================================================
# LibroSys Backend — variables de entorno
# =============================================================================

# --- SQL Server (Editoriales + legacy /api/test-db) ---
# Instancia local MSSQLSERVER; TCP/IP debe estar habilitado (puerto 1433).
DB_SERVER=localhost
DB_USER=LibreriaUser
DB_PASSWORD=
DB_DATABASE=LibroSys
PORT=3001

# --- MySQL (otros catálogos legacy: monedas, categorías, etc.) ---
# No use DB_USER/DB_PASSWORD del mssql aquí.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=librosys
MYSQL_USER=root
MYSQL_PASSWORD=

# --- Módulo Inventario (Fase 4) ---
NODE_ENV=development
INVENTARIO_PORT=3002
LOG_LEVEL=info
DB_DRIVER=memory
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=librosys
# DB_USER=
# DB_PASSWORD=
OUTBOX_POLL_MS=5000
CORS_ORIGIN=*
