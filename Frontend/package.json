{
  "name": "librosys-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,web -c blue,green \"npm run start --prefix ../backend\" \"npx --yes wait-on -t 120000 http-get://127.0.0.1:3001/api/productos && npm run dev:web\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
