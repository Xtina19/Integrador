-- =============================================
-- MODULO CONTACTO (TELÉFONOS Y DIRECCIONES)
-- =============================================
CREATE TABLE TipoTelefono (
    id_tipo_telefono INT PRIMARY KEY IDENTITY,
    nombre VARCHAR(50) NOT NULL,
    descripcion VARCHAR(150),
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo'
);

CREATE TABLE Telefono (
    id_telefono INT PRIMARY KEY IDENTITY,
    id_tipo_telefono INT NOT NULL,
    numero VARCHAR(20) NOT NULL,
    codigo_pais VARCHAR(10) NOT NULL DEFAULT '+1',
    es_principal BIT NOT NULL DEFAULT 0,
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo',
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT fk_tel_tipo FOREIGN KEY (id_tipo_telefono) REFERENCES TipoTelefono(id_tipo_telefono)
);

CREATE TABLE Pais (
    id_pais INT PRIMARY KEY IDENTITY,
    nombre VARCHAR(100) NOT NULL,
    codigo_iso CHAR(3) NOT NULL UNIQUE,
    codigo_telefono VARCHAR(10),
    moneda VARCHAR(50),
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo'
);

CREATE TABLE Ciudad (
    id_ciudad INT PRIMARY KEY IDENTITY,
    id_pais INT NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    codigo_postal VARCHAR(20),
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo',
    CONSTRAINT fk_ciu_pais FOREIGN KEY (id_pais) REFERENCES Pais(id_pais)
);

CREATE TABLE TipoDireccion (
    id_tipo_direccion INT PRIMARY KEY IDENTITY,
    nombre VARCHAR(50) NOT NULL,
    descripcion VARCHAR(150),
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo'
);

CREATE TABLE Direccion (
    id_direccion INT PRIMARY KEY IDENTITY,
    id_tipo_direccion INT NOT NULL,
    id_ciudad INT NOT NULL,
    calle VARCHAR(200) NOT NULL,
    numero_exterior VARCHAR(20),
    numero_interior VARCHAR(20),
    sector VARCHAR(100),
    referencia VARCHAR(255),
    codigo_postal VARCHAR(20),
    es_principal BIT NOT NULL DEFAULT 0,
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo',
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT fk_dir_tipo FOREIGN KEY (id_tipo_direccion) REFERENCES TipoDireccion(id_tipo_direccion),
    CONSTRAINT fk_dir_ciudad FOREIGN KEY (id_ciudad) REFERENCES Ciudad(id_ciudad)
);

-- =============================================
-- MODULO PERSONAS Y ENTIDADES COMERCIALES
-- =============================================
CREATE TABLE Persona (
    id_persona INT PRIMARY KEY IDENTITY,
    tipo_persona VARCHAR(20) NOT NULL,
    nombres VARCHAR(100),
    apellidos VARCHAR(100),
    razon_social VARCHAR(200),
    documento_tipo VARCHAR(30) NOT NULL,
    documento_numero VARCHAR(50) NOT NULL UNIQUE,
    correo VARCHAR(150),
    fecha_nacimiento DATE,
    genero VARCHAR(20),
    tipo_cliente VARCHAR(30) NULL,
    id_sucursal_preferida INT NULL,
    sucursal_preferida VARCHAR(100) NULL,
    observaciones VARCHAR(255) NULL,
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo',
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE()
);

CREATE TABLE Persona_Tiene_Telefono (
    id_persona_telefono INT PRIMARY KEY IDENTITY,
    id_persona INT NOT NULL,
    id_telefono INT NOT NULL,
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT fk_ptt_persona FOREIGN KEY (id_persona) REFERENCES Persona(id_persona),
    CONSTRAINT fk_ptt_telefono FOREIGN KEY (id_telefono) REFERENCES Telefono(id_telefono),
    CONSTRAINT uq_ptt UNIQUE (id_persona, id_telefono)
);

CREATE TABLE Persona_Tiene_Direccion (
    id_persona_direccion INT PRIMARY KEY IDENTITY,
    id_persona INT NOT NULL,
    id_direccion INT NOT NULL,
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT fk_ptd_persona FOREIGN KEY (id_persona) REFERENCES Persona(id_persona),
    CONSTRAINT fk_ptd_direccion FOREIGN KEY (id_direccion) REFERENCES Direccion(id_direccion),
    CONSTRAINT uq_ptd UNIQUE (id_persona, id_direccion)
);

CREATE TABLE Usuario (
    id_usuario INT PRIMARY KEY IDENTITY,
    id_persona INT,
    nombre_usuario VARCHAR(80) NOT NULL UNIQUE,
    correo VARCHAR(150) NOT NULL UNIQUE,
    contrasena_hash VARCHAR(255) NOT NULL,
    rol VARCHAR(50) NOT NULL DEFAULT 'usuario',
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo',
    ultimo_acceso DATETIME,
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE(),
    fecha_actualizacion DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT fk_usuario_persona FOREIGN KEY (id_persona) REFERENCES Persona(id_persona),
);

CREATE TABLE Rol (
    id_rol INT PRIMARY KEY IDENTITY,
    codigo VARCHAR(30) NOT NULL,
    slug VARCHAR(30) NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    descripcion VARCHAR(255) NULL,
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo',
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT UQ_Rol_codigo UNIQUE (codigo),
    CONSTRAINT UQ_Rol_slug UNIQUE (slug)
);

CREATE TABLE TipoProveedor (
    id_tipo_proveedor INT PRIMARY KEY IDENTITY,
    nombre VARCHAR(100) NOT NULL,
    descripcion VARCHAR(255),
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo'
);

CREATE TABLE Proveedor (
    id_proveedor INT PRIMARY KEY IDENTITY,
    id_persona INT NOT NULL,
    id_tipo_proveedor INT NOT NULL,
    codigo_proveedor VARCHAR(50) NOT NULL UNIQUE,
    nombre_comercial VARCHAR(200) NOT NULL,
    sitio_web VARCHAR(200),
    condiciones_pago VARCHAR(100),
    moneda_preferida VARCHAR(10) NOT NULL DEFAULT 'DOP',
    es_internacional BIT NOT NULL DEFAULT 0,
    id_pais INT,
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo',
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT fk_prov_persona FOREIGN KEY (id_persona) REFERENCES Persona(id_persona),
    CONSTRAINT fk_prov_tipo FOREIGN KEY (id_tipo_proveedor) REFERENCES TipoProveedor(id_tipo_proveedor),
    CONSTRAINT fk_prov_pais FOREIGN KEY (id_pais) REFERENCES Pais(id_pais)
);

CREATE TABLE Autor (
    id_autor INT PRIMARY KEY IDENTITY,
    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    nacionalidad VARCHAR(50),
    fecha_nacimiento DATE,
    biografia TEXT,
    fecha_registro DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE Editorial (
    id_editorial INT PRIMARY KEY IDENTITY,
    codigo_editorial VARCHAR(30) NULL,
    nombre VARCHAR(150) NOT NULL,
    pais_origen VARCHAR(50),
    sitio_web VARCHAR(200),
    correo_contacto VARCHAR(100),
    telefono VARCHAR(20),
    nombre_contacto VARCHAR(150) NULL,
    tipo_contrato VARCHAR(100) NULL,
    vencimiento_contrato DATE NULL,
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo',
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT UQ_Editorial_codigo UNIQUE (codigo_editorial)
);

CREATE TABLE CategoriaProducto (
    id_categoria INT PRIMARY KEY IDENTITY,
    nombre_categoria VARCHAR(100) NOT NULL,
    descripcion VARCHAR(255),
    estado VARCHAR(20) DEFAULT 'Activo'
);

CREATE TABLE Producto (
    id_producto INT PRIMARY KEY IDENTITY,
    codigo_producto VARCHAR(50) NOT NULL UNIQUE,
    titulo VARCHAR(200) NOT NULL,
    isbn VARCHAR(20) NOT NULL UNIQUE,
    id_autor INT NOT NULL,
    id_editorial INT NOT NULL,
    id_categoria INT NOT NULL,
    costo_referencia DECIMAL(12, 2) NOT NULL DEFAULT 0,
    precio DECIMAL(10, 2) NOT NULL,
    idioma VARCHAR(50),
    numero_paginas INT,
    fecha_publicacion DATE,
    edicion VARCHAR(50),
    sinopsis TEXT,
    imagen_portada VARCHAR(255),
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo',
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT fk_producto_autor FOREIGN KEY (id_autor) REFERENCES Autor(id_autor),
    CONSTRAINT fk_producto_editorial FOREIGN KEY (id_editorial) REFERENCES Editorial(id_editorial),
    CONSTRAINT fk_producto_categoria FOREIGN KEY (id_categoria) REFERENCES CategoriaProducto(id_categoria)
);

-- =============================================
-- MODULO CONFIGURACION (MONEDAS, TASAS, FORMAS DE PAGO)
-- =============================================
CREATE TABLE Moneda (
    id_moneda INT PRIMARY KEY IDENTITY,
    codigo_iso CHAR(3) NOT NULL,
    simbolo VARCHAR(10) NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    estado VARCHAR(20) NOT NULL DEFAULT 'Activa',
    es_predeterminada BIT NOT NULL DEFAULT 0,
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT UQ_Moneda_codigo UNIQUE (codigo_iso)
);

CREATE TABLE TasaCambio (
    id_tasa_cambio INT PRIMARY KEY IDENTITY,
    id_moneda_origen INT NOT NULL,
    id_moneda_destino INT NOT NULL,
    valor DECIMAL(18, 6) NOT NULL,
    fecha_tasa DATE NOT NULL,
    notas VARCHAR(255) NULL,
    actualizado_por VARCHAR(100) NOT NULL DEFAULT 'Sistema',
    estado VARCHAR(20) NOT NULL DEFAULT 'Activa',
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT fk_tasa_origen FOREIGN KEY (id_moneda_origen) REFERENCES Moneda(id_moneda),
    CONSTRAINT fk_tasa_destino FOREIGN KEY (id_moneda_destino) REFERENCES Moneda(id_moneda),
    CONSTRAINT uq_tasa_par_fecha UNIQUE (id_moneda_origen, id_moneda_destino, fecha_tasa)
);

CREATE TABLE FormaPago (
    id_forma_pago INT PRIMARY KEY IDENTITY,
    codigo VARCHAR(30) NOT NULL,
    slug VARCHAR(30) NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo',
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT UQ_FormaPago_codigo UNIQUE (codigo),
    CONSTRAINT UQ_FormaPago_slug UNIQUE (slug)
);

-- =============================================
-- MODULO INVENTARIO
-- =============================================
CREATE TABLE Sucursal (
    id_sucursal INT PRIMARY KEY IDENTITY,
    id_direccion INT NOT NULL,
    nombre VARCHAR(150) NOT NULL,
    codigo_sucursal VARCHAR(30) NOT NULL UNIQUE,
    telefono VARCHAR(20),
    correo VARCHAR(150),
    responsable VARCHAR(150),
    es_principal BIT NOT NULL DEFAULT 0,
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo',
    fecha_registro DATETIME NOT NULL DEFAULT GETDATE(),
    CONSTRAINT fk_suc_direccion FOREIGN KEY (id_direccion) REFERENCES Direccion(id_direccion)
);

CREATE TABLE Almacen (
    id_almacen INT PRIMARY KEY IDENTITY(1, 1),
    id_sucursal INT,
    nombre VARCHAR(100) NOT NULL,
    codigo_almacen VARCHAR(30) NOT NULL UNIQUE,
    direccion VARCHAR(200),
    ciudad VARCHAR(100),
    responsable VARCHAR(150),
    telefono VARCHAR(20),
    tipo_almacen VARCHAR(50),
    bloqueado BIT NOT NULL DEFAULT 0,
    motivo_bloqueo VARCHAR(255),
    fecha_bloqueo DATETIME2(0),
    estado VARCHAR(20) NOT NULL DEFAULT 'Activo',
    fecha_registro DATETIME2(0) NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT fk_almacen_sucursal FOREIGN KEY (id_sucursal) REFERENCES Sucursal(id_sucursal),
    CONSTRAINT uq_almacen_nombre_sucursal UNIQUE (id_sucursal, nombre),
);

CREATE TABLE Inventario (
    id_inventario INT PRIMARY KEY IDENTITY(1, 1),
    id_producto INT NOT NULL,
    id_almacen INT NOT NULL,
    stock_actual INT NOT NULL DEFAULT 0,
    stock_minimo INT NOT NULL DEFAULT 0,
    stock_maximo INT,
    ubicacion VARCHAR(150) NOT NULL,
    version INT NOT NULL DEFAULT 1,
    fecha_actualizacion DATETIME2(0) NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT fk_inv_producto FOREIGN KEY (id_producto) REFERENCES Producto(id_producto),
    CONSTRAINT fk_inv_almacen FOREIGN KEY (id_almacen) REFERENCES Almacen(id_almacen),
    CONSTRAINT uq_inv_producto_almacen UNIQUE (id_producto, id_almacen),
);

CREATE TABLE TransferenciaInventario (
    id_transferencia INT PRIMARY KEY IDENTITY(1, 1),
    codigo VARCHAR(30) NOT NULL UNIQUE,
    id_almacen_origen INT NOT NULL,
    id_almacen_destino INT NOT NULL,
    id_solicitante INT NOT NULL,
    estado VARCHAR(30) NOT NULL DEFAULT 'borrador',
    observacion VARCHAR(255),
    version INT NOT NULL DEFAULT 1,
    fecha_registro DATETIME2(0) NOT NULL DEFAULT SYSDATETIME(),
    fecha_solicitud DATETIME2(0),
    fecha_despacho DATETIME2(0),
    fecha_recepcion DATETIME2(0) NULL,
    fecha_finalizacion DATETIME2(0),
    CONSTRAINT fk_transferencia_origen FOREIGN KEY (id_almacen_origen) REFERENCES Almacen(id_almacen),
    CONSTRAINT fk_transferencia_destino FOREIGN KEY (id_almacen_destino) REFERENCES Almacen(id_almacen),
    CONSTRAINT fk_transferencia_solicitante FOREIGN KEY (id_solicitante) REFERENCES Usuario(id_usuario),
    CONSTRAINT chk_transferencia_almacenes CHECK (id_almacen_origen <> id_almacen_destino),
);

CREATE TABLE DetalleTransferenciaInventario (
    id_detalle_transferencia INT PRIMARY KEY IDENTITY(1, 1),
    id_transferencia INT NOT NULL,
    id_producto INT NOT NULL,
    cantidad_solicitada INT NOT NULL,
    cantidad_despachada INT NOT NULL DEFAULT 0,
    cantidad_recibida INT NOT NULL DEFAULT 0,
    cantidad_faltante INT NOT NULL DEFAULT 0,
    cantidad_danada INT NOT NULL DEFAULT 0,
    observacion VARCHAR(255),
    CONSTRAINT fk_det_transferencia FOREIGN KEY (id_transferencia) REFERENCES TransferenciaInventario(id_transferencia),
    CONSTRAINT fk_det_transferencia_producto FOREIGN KEY (id_producto) REFERENCES Producto(id_producto),
    CONSTRAINT uq_det_transferencia_producto UNIQUE (id_transferencia, id_producto),
);

CREATE TABLE RecepcionTransferencia (
    id_recepcion INT PRIMARY KEY IDENTITY(1, 1),
    id_transferencia INT NOT NULL,
    id_usuario INT NOT NULL,
    clave_idempotencia VARCHAR(100) NOT NULL UNIQUE,
    observacion VARCHAR(255),
    fecha_recepcion DATETIME2(0) NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT fk_recepcion_transferencia FOREIGN KEY (id_transferencia) REFERENCES TransferenciaInventario(id_transferencia),
    CONSTRAINT fk_recepcion_usuario FOREIGN KEY (id_usuario) REFERENCES Usuario(id_usuario)
);

CREATE TABLE DetalleRecepcionTransferencia (
    id_detalle_recepcion INT PRIMARY KEY IDENTITY(1, 1),
    id_recepcion INT NOT NULL,
    id_detalle_transferencia INT NOT NULL,
    cantidad_recibida INT NOT NULL DEFAULT 0,
    cantidad_faltante INT NOT NULL DEFAULT 0,
    cantidad_danada INT NOT NULL DEFAULT 0,
    observacion VARCHAR(255),
    CONSTRAINT fk_det_recepcion FOREIGN KEY (id_recepcion) REFERENCES RecepcionTransferencia(id_recepcion),
    CONSTRAINT fk_det_recepcion_transferencia FOREIGN KEY (id_detalle_transferencia) REFERENCES DetalleTransferenciaInventario(id_detalle_transferencia),
    CONSTRAINT uq_det_recepcion_linea UNIQUE (id_recepcion, id_detalle_transferencia)
);

CREATE TABLE ConteoInventario (
    id_conteo INT PRIMARY KEY IDENTITY(1, 1),
    codigo VARCHAR(30) NOT NULL UNIQUE,
    nombre VARCHAR(150) NOT NULL,
    id_sucursal INT NOT NULL,
    id_almacen INT NOT NULL,
    tipo_conteo VARCHAR(30) NOT NULL,
    alcance_tipo VARCHAR(30) NOT NULL,
    alcance_valor VARCHAR(200),
    fecha_programada DATE,
    hora_programada TIME(0),
    id_responsable INT,
    responsable_nombre VARCHAR(150),
    observaciones VARCHAR(255),
    bloquear_almacen_al_abrir BIT NOT NULL DEFAULT 0,
    permitir_reconteo BIT NOT NULL DEFAULT 1,
    diferencia_minima_reconteo INT NOT NULL DEFAULT 1,
    estado VARCHAR(30) NOT NULL DEFAULT 'borrador',
    fase VARCHAR(30) NOT NULL DEFAULT 'Crear',
    bloqueo_activo BIT NOT NULL DEFAULT 0,
    version INT NOT NULL DEFAULT 1,
    fecha_registro DATETIME2(0) NOT NULL DEFAULT SYSDATETIME(),
    fecha_apertura DATETIME2(0),
    fecha_cierre DATETIME2(0),
    CONSTRAINT fk_conteo_sucursal FOREIGN KEY (id_sucursal) REFERENCES Sucursal(id_sucursal),
    CONSTRAINT fk_conteo_almacen FOREIGN KEY (id_almacen) REFERENCES Almacen(id_almacen),
    CONSTRAINT fk_conteo_responsable FOREIGN KEY (id_responsable) REFERENCES Usuario(id_usuario)
);

CREATE TABLE SnapshotConteoInventario (
    id_snapshot INT PRIMARY KEY IDENTITY(1, 1),
    id_conteo INT NOT NULL,
    id_producto INT NOT NULL,
    cantidad_teorica INT NOT NULL,
    costo_referencia DECIMAL(12, 2) NOT NULL DEFAULT 0,
    fecha_snapshot DATETIME2(0) NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT fk_snapshot_conteo FOREIGN KEY (id_conteo) REFERENCES ConteoInventario(id_conteo),
    CONSTRAINT fk_snapshot_producto FOREIGN KEY (id_producto) REFERENCES Producto(id_producto),
    CONSTRAINT uq_snapshot_conteo_producto UNIQUE (id_conteo, id_producto)
);

CREATE TABLE DetalleConteoInventario (
    id_detalle_conteo INT PRIMARY KEY IDENTITY(1, 1),
    id_conteo INT NOT NULL,
    id_snapshot INT NOT NULL,
    id_producto INT NOT NULL,
    cantidad_contada INT,
    cantidad_reconteo INT,
    cantidad_aceptada INT,
    diferencia INT,
    clasificacion VARCHAR(30),
    estado_linea VARCHAR(30) NOT NULL DEFAULT 'pendiente',
    regularizacion_tipo VARCHAR(20),
    regularizacion_id INT,
    observacion VARCHAR(255),
    CONSTRAINT fk_det_conteo FOREIGN KEY (id_conteo) REFERENCES ConteoInventario(id_conteo),
    CONSTRAINT fk_det_conteo_snapshot FOREIGN KEY (id_snapshot) REFERENCES SnapshotConteoInventario(id_snapshot),
    CONSTRAINT fk_det_conteo_producto FOREIGN KEY (id_producto) REFERENCES Producto(id_producto),
    CONSTRAINT uq_det_conteo_producto UNIQUE (id_conteo, id_producto)
);

CREATE TABLE ProductoAlcanceConteoInventario (
    id_alcance_conteo INT PRIMARY KEY IDENTITY(1, 1),
    id_conteo INT NOT NULL,
    id_producto INT NOT NULL,
    fecha_registro DATETIME2(0) NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT fk_alcance_conteo FOREIGN KEY (id_conteo) REFERENCES ConteoInventario(id_conteo),
    CONSTRAINT fk_alcance_conteo_producto FOREIGN KEY (id_producto) REFERENCES Producto(id_producto),
    CONSTRAINT uq_alcance_conteo_producto UNIQUE (id_conteo, id_producto)
);

CREATE TABLE AjusteInventario (
        id_ajuste INT PRIMARY KEY IDENTITY(1, 1),
        codigo VARCHAR(30) NOT NULL UNIQUE,
        id_almacen INT NOT NULL,
        tipo_ajuste VARCHAR(30) NOT NULL,
        estado VARCHAR(30) NOT NULL DEFAULT 'borrador',
        id_solicitante INT NOT NULL,
        id_aprobador INT,
        observacion VARCHAR(255),
        documento_origen_tipo VARCHAR(50),
        documento_origen_id INT,
        version INT NOT NULL DEFAULT 1,
        fecha_registro DATETIME2(0) NOT NULL DEFAULT SYSDATETIME(),
        fecha_solicitud DATETIME2(0),
        fecha_aprobacion DATETIME2(0),
        fecha_aplicacion DATETIME2(0),
        CONSTRAINT fk_ajuste_almacen FOREIGN KEY (id_almacen) REFERENCES Almacen(id_almacen),
        CONSTRAINT fk_ajuste_solicitante FOREIGN KEY (id_solicitante) REFERENCES Usuario(id_usuario),
        CONSTRAINT fk_ajuste_aprobador FOREIGN KEY (id_aprobador) REFERENCES Usuario(id_usuario),
    );

CREATE TABLE DetalleAjusteInventario (
    id_detalle_ajuste INT PRIMARY KEY IDENTITY(1, 1),
    id_ajuste INT NOT NULL,
    id_producto INT NOT NULL,
    cantidad_objetivo INT NOT NULL,
    diferencia INT NOT NULL,
    existencia_anterior INT NOT NULL,
    motivo_codigo VARCHAR(50),
    id_detalle_conteo INT,
    observacion VARCHAR(255),
    CONSTRAINT fk_det_ajuste FOREIGN KEY (id_ajuste) REFERENCES AjusteInventario(id_ajuste),
    CONSTRAINT fk_det_ajuste_producto FOREIGN KEY (id_producto) REFERENCES Producto(id_producto),
    CONSTRAINT fk_det_ajuste_conteo FOREIGN KEY (id_detalle_conteo) REFERENCES DetalleConteoInventario(id_detalle_conteo),
    CONSTRAINT uq_det_ajuste_producto UNIQUE (id_ajuste, id_producto),
);

CREATE TABLE DescarteInventario (
    id_descarte INT PRIMARY KEY IDENTITY(1, 1),
    codigo VARCHAR(30) NOT NULL UNIQUE,
    fecha DATE NOT NULL,
    id_sucursal INT NOT NULL,
    id_almacen INT NOT NULL,
    id_responsable INT,
    responsable_nombre VARCHAR(150),
    motivo_codigo VARCHAR(30) NOT NULL,
    motivo_descripcion VARCHAR(255),
    observaciones VARCHAR(255),
    requiere_aprobacion BIT NOT NULL DEFAULT 1,
    id_supervisor INT,
    supervisor_nombre VARCHAR(150),
    id_solicitante INT NOT NULL,
    id_aprobador INT,
    estado VARCHAR(30) NOT NULL DEFAULT 'borrador',
    documento_origen_tipo VARCHAR(50),
    documento_origen_id INT,
    version INT NOT NULL DEFAULT 1,
    fecha_registro DATETIME2(0) NOT NULL DEFAULT SYSDATETIME(),
    fecha_solicitud DATETIME2(0),
    fecha_aprobacion DATETIME2(0),
    fecha_aplicacion DATETIME2(0),
    CONSTRAINT fk_descarte_sucursal FOREIGN KEY (id_sucursal) REFERENCES Sucursal(id_sucursal),
    CONSTRAINT fk_descarte_almacen FOREIGN KEY (id_almacen) REFERENCES Almacen(id_almacen),
    CONSTRAINT fk_descarte_responsable FOREIGN KEY (id_responsable) REFERENCES Usuario(id_usuario),
    CONSTRAINT fk_descarte_supervisor FOREIGN KEY (id_supervisor) REFERENCES Usuario(id_usuario),
    CONSTRAINT fk_descarte_solicitante FOREIGN KEY (id_solicitante) REFERENCES Usuario(id_usuario),
    CONSTRAINT fk_descarte_aprobador FOREIGN KEY (id_aprobador) REFERENCES Usuario(id_usuario),
);

CREATE TABLE DetalleDescarteInventario (
    id_detalle_descarte INT PRIMARY KEY IDENTITY(1, 1),
    id_descarte INT NOT NULL,
    id_producto INT NOT NULL,
    existencia_actual INT NOT NULL,
    cantidad INT NOT NULL,
    costo_unitario DECIMAL(12, 2) NOT NULL DEFAULT 0,
    motivo_especifico VARCHAR(150),
    id_detalle_conteo INT,
    observacion VARCHAR(255),
    CONSTRAINT fk_det_descarte FOREIGN KEY (id_descarte) REFERENCES DescarteInventario(id_descarte),
    CONSTRAINT fk_det_descarte_producto FOREIGN KEY (id_producto) REFERENCES Producto(id_producto),
    CONSTRAINT fk_det_descarte_conteo FOREIGN KEY (id_detalle_conteo) REFERENCES DetalleConteoInventario(id_detalle_conteo),
    CONSTRAINT uq_det_descarte_producto UNIQUE (id_descarte, id_producto),
);

CREATE TABLE EvidenciaDescarteInventario (
    id_evidencia INT PRIMARY KEY IDENTITY(1, 1),
    id_descarte INT NOT NULL,
    tipo VARCHAR(20) NOT NULL,
    nombre_archivo VARCHAR(255),
    url_referencia VARCHAR(500),
    comentario VARCHAR(500),
    id_usuario INT NOT NULL,
