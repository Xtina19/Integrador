INSERT INTO
    TasaCambio (
        id_moneda_origen,
        id_moneda_destino,
        valor,
        fecha_tasa,
        notas,
        actualizado_por,
        estado
    )
SELECT
    mo.id_moneda,
    md.id_moneda,
    v.valor,
    v.fecha_tasa,
    v.notas,
    'Sistema',
    'Activa'
FROM (
    VALUES
        ('USD', 58.29, '2026-08-05', 'Tasa de referencia mercado interbancario (Xe)'),
        ('EUR', 63.5, '2026-08-05', 'Estimado vía cruce EUR/USD'),
        ('GBP', 74.05, '2026-08-05', 'Estimado vía cruce GBP/USD'),
        ('MXN', 3.15, '2026-08-05', 'Estimado vía cruce MXN/USD'),
        ('COP', 0.0146, '2026-08-05', 'Estimado vía cruce COP/USD'),
        (
            'ARS',
            0.058,
            '2026-08-05',
            'Estimado vía cruce ARS/USD, alta volatilidad'
        ),
        ('CLP', 0.0614, '2026-08-05', 'Estimado vía cruce CLP/USD'),
        ('BRL', 10.41, '2026-08-05', 'Estimado vía cruce BRL/USD'),
        ('CAD', 42.55, '2026-08-05', 'Estimado vía cruce CAD/USD'),
        ('JPY', 0.3886, '2026-08-05', 'Estimado vía cruce JPY/USD'),
        ('PEN', 15.54, '2026-08-05', 'Estimado vía cruce PEN/USD')
) AS v (origen, valor, fecha_tasa, notas)
INNER JOIN Moneda mo ON mo.codigo_iso = v.origen
INNER JOIN Moneda md ON md.codigo_iso = 'DOP';

